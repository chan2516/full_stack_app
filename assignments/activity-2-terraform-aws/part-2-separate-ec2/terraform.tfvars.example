aws_region            = "ap-south-1"
instance_type         = "t3.micro"
key_name              = "YOUR_EXISTING_KEY_PAIR"
allowed_ssh_cidr      = "YOUR.PUBLIC.IP/32"
public_app_cidr       = "0.0.0.0/0"
