[Unit]
Description=Contact Application Flask Backend
After=network-online.target

[Service]
User=jenkins
Group=jenkins
WorkingDirectory=/opt/contact-app/backend
EnvironmentFile=/opt/contact-app/backend.env
ExecStart=/opt/contact-app/backend/venv/bin/gunicorn --bind 0.0.0.0:5000 --workers 2 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
