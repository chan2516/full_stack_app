# Docker Hub username used when tagging images
DOCKERHUB_USERNAME=your-dockerhub-username

# Flask backend — same database as first_app
FLASK_SECRET_KEY=change-me-in-production
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appName>
MONGODB_DATABASE=first_project
MONGODB_COLLECTION=submissions
CORS_ORIGINS=http://localhost:3000

# Optional: use local MongoDB instead of Atlas (run: docker compose --profile local-mongo up)
# MONGODB_URI=mongodb://mongo:27017
